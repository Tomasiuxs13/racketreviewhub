{
  "name": "racket-review-hub",
  "version": "1.0.0",
  "description": "Static site for padel racket reviews with automated product data ingestion.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/server && esbuild server/scripts/cjCronJob.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/server/scripts && esbuild server/scripts/padelMarketCronJob.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/server/scripts && esbuild server/scripts/combinedFeedSyncCronJob.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/server/scripts",
    "start": "node dist/server/index.js",
    "check": "tsc",
    "sync:padel": "node scripts/sync-padel-data.js",
    "generate:reviews": "node scripts/generate-reviews.js",
    "generate:reviews:ai": "node scripts/generate-reviews.js --use-chatgpt",
    "update:brands": "node scripts/update-brand-pages.js",
    "generate:all": "npm run generate:reviews && npm run update:brands",
    "generate:all:ai": "npm run generate:reviews:ai && npm run update:brands",
    "sync:with-reviews": "AUTO_GENERATE_REVIEWS=true npm run sync:padel && npm run generate:reviews && npm run update:brands",
    "cj:sync": "tsx server/scripts/cjCronJob.ts",
    "cj:sync:quick": "tsx server/scripts/cjCronJob.ts --quick",
    "cj:sync:local": "tsx server/scripts/cjCronJob.ts --local",
    "cj:sync:dry-run": "tsx server/scripts/cjCronJob.ts --dry-run",
    "padel-market:sync": "tsx server/scripts/padelMarketCronJob.ts",
    "padel-market:sync:local": "tsx server/scripts/padelMarketCronJob.ts --local",
    "padel-market:sync:dry-run": "tsx server/scripts/padelMarketCronJob.ts --dry-run",
    "sync:combined": "tsx server/scripts/combinedFeedSyncCronJob.ts",
    "sync:combined:quick": "tsx server/scripts/combinedFeedSyncCronJob.ts --quick",
    "sync:combined:local": "tsx server/scripts/combinedFeedSyncCronJob.ts --local",
    "sync:combined:dry-run": "tsx server/scripts/combinedFeedSyncCronJob.ts --dry-run",
    "bulk:publish": "tsx server/scripts/bulkPublishRackets.ts",
    "bulk:publish:skip-reviews": "tsx server/scripts/bulkPublishRackets.ts --skip-reviews",
    "bulk:publish:skip-translations": "tsx server/scripts/bulkPublishRackets.ts --skip-translations"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-aspect-ratio": "^1.0.3",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-toggle-group": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/supabase-js": "^2.39.8",
    "@tanstack/react-query": "^5.28.4",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "csv-parse": "^6.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.7",
    "drizzle-zod": "^0.5.1",
    "embla-carousel-react": "^8.0.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "framer-motion": "^11.0.20",
    "fs-extra": "^11.2.0",
    "input-otp": "^1.2.4",
    "isomorphic-dompurify": "^2.32.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.363.0",
    "memorystore": "^1.6.7",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.29.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "plist": "^3.1.0",
    "postgres": "^3.4.4",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.51.1",
    "react-resizable-panels": "^2.0.16",
    "recharts": "^2.12.3",
    "ssh2-sftp-client": "^12.0.1",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.1",
    "vaul": "^0.9.0",
    "wouter": "^3.1.2",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/adm-zip": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "20.11.30",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.22",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.20.14",
    "esbuild": "^0.20.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "5.4.3",
    "vite": "^5.2.6"
  }
}
